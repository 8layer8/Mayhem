# Port the server listens on (also exposed by Docker)
PORT=8080

# Secret used to encrypt the session cookie. MUST be set and >= 32 chars.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: pin a stable Plex client identifier. If unset, one is generated
# and persisted to the data volume (./data/client-id) on first run.
# PLEX_CLIENT_IDENTIFIER=

# Optional: set to "true" when serving over HTTPS so the session cookie is
# marked Secure. Defaults to false for plain-HTTP / LAN use.
COOKIE_SECURE=false

# App title shown in the sidebar, login screen, and browser tab (default: Mayhem).
# Also used as the Plex device/product name in authorized devices.
APP_TITLE=Mayhem

# UI scale for buttons and the now-playing album cover.
# Options: small | medium | large | extra-large | full (default: medium).
# extra-large maximizes album art. full uses album art as the now-playing background
# and disables the visualizer.
UI_SCALE=medium

# Show the frequency visualizer on the now-playing screen (default: true).
# Ignored when UI_SCALE=full.
VISUALIZER_ENABLED=true
